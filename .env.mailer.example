# Modèle uniquement : copier ces variables dans .env.local (ignoré par Git).
# Serveur exact : LWS Panel > E-mails > paramètres de connexion SMTP.
# LWS : SSL/TLS sur le port 465 ; identifiant = adresse e-mail complète.
# Encoder séparément l’identifiant et le mot de passe avec rawurlencode.
# Ne jamais mettre le mot de passe réel dans ce fichier versionné.
MAILER_DSN="smtps://contact%40gmcmauritanie.com:MOT_DE_PASSE_ENCODE@mail28.lwspanel.com:465"
MAILER_FROM=contact@gmcmauritanie.com
MAILER_TO=contact@gmcmauritanie.com
