<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>{% block title %}Administration · GMC{% endblock %}</title><link rel="stylesheet" href="{{ asset('vendor/bootstrap/css/bootstrap.min.css') }}"><link rel="stylesheet" href="{{ asset('vendor/fontawesome-free/css/all.min.css') }}"><link rel="stylesheet" href="{{ asset('css/admin-cms.css') }}"></head><body>
{% if app.user %}<aside class="admin-sidebar"><a class="admin-brand" href="{{ path('admin_home') }}">GMC<span>Administration du site</span></a><nav aria-label="Administration"><a href="{{ path('admin_home') }}"><i class="fas fa-gauge"></i> Tableau de bord</a>{% for key,label in constant('App\\Cms\\Schema::TYPES') %}<a href="{{ path('cms_list',{type:key}) }}" {% if type|default('')==key %}aria-current="page"{% endif %}>{{ label }}</a>{% endfor %}<a href="{{ path('cms_media') }}"><i class="fas fa-images"></i> Médiathèque</a></nav></aside>{% endif %}
<div class="admin-shell {{ app.user ? '' : 'admin-login' }}"><header class="admin-top"><span>GMC Mauritanie</span><div class="d-flex gap-3 align-items-center"><a href="{{ path('app_home') }}" target="_blank" rel="noopener">Voir le site</a>{% if app.user %}<form action="{{ path('admin_logout') }}" method="post"><input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_logout') }}"><button class="btn btn-outline-secondary btn-sm">Se déconnecter</button></form>{% endif %}</div></header><main class="admin-main">{% for message in app.flashes('success') %}<div class="alert alert-success" role="status">{{ message }}</div>{% endfor %}{% block body %}{% endblock %}</main></div><script src="{{ asset('js/admin-cms.js') }}" defer></script></body></html>
