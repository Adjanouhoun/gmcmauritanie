{% extends 'admin/base.html.twig' %}{% block title %}{{ types[type] }} · GMC{% endblock %}{% block body %}<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4"><div><p class="eyebrow">CONTENUS</p><h1>{{ types[type] }}</h1></div>{% if not single %}<a class="btn btn-primary" href="{{ path('cms_new',{type:type}) }}">Ajouter</a>{% endif %}</div><div class="admin-card"><p class="text-secondary">Les éléments publiés apparaissent sur le site dans l’ordre indiqué. Un contenu archivé peut être republié depuis son formulaire.</p><div class="d-flex flex-wrap gap-3 mb-4"><input class="form-control" style="max-width:320px" type="search" placeholder="Rechercher un contenu" aria-label="Rechercher" data-filter-list><select class="form-select" style="max-width:220px" aria-label="Filtrer par état" data-status-filter><option value="">Tous les états</option><option value="published">Publiés</option><option value="draft">Brouillons</option><option value="archived">Archivés</option></select></div><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Titre</th><th>État</th><th>Ordre</th><th>Actions</th></tr></thead><tbody>{% for row in rows %}<tr data-list-item data-status="{{ row.status }}"><td><strong>{{ row.title }}</strong></td><td><span class="status status-{{ row.status }}">{{ {published:'Publié',draft:'Brouillon',archived:'Archivé'}[row.status] }}</span></td><td>{{ row.position }}</td><td><div class="d-flex gap-3"><a href="{{ path('cms_edit',{type:type,id:row.id}) }}">Modifier</a><a href="{{ path('cms_preview',{id:row.id}) }}" target="_blank" rel="noopener">Aperçu</a></div></td></tr>{% else %}<tr><td colspan="4">Aucun contenu. Commencez avec le bouton Ajouter.</td></tr>{% endfor %}</tbody></table></div></div>{% endblock %}
