{% extends 'admin/base.html.twig' %}{% block title %}Médiathèque · GMC{% endblock %}{% block body %}<h1 class="mb-4">Médiathèque</h1>{% if error %}<div class="alert alert-danger" role="alert">{{ error }}</div>{% endif %}<form class="admin-card mb-4" method="post" enctype="multipart/form-data"><input type="hidden" name="_token" value="{{ csrf_token('media') }}"><h2 class="h5">Importer un média</h2><div class="row g-3 align-items-end"><div class="col-lg-5"><label for="file" class="form-label">Image ou document PDF</label><input class="form-control" id="file" name="file" type="file" accept="image/jpeg,image/png,image/webp,application/pdf" required><div class="form-text">JPG, PNG, WebP ou PDF · {{ maxMb }} Mo maximum.</div></div><div class="col-lg-5"><label for="alt" class="form-label">Description de l’image (accessibilité)</label><input class="form-control" id="alt" name="alt" maxlength="300"></div><div class="col-lg-2"><button class="btn btn-primary">Importer</button></div></div></form><input class="form-control mb-4" type="search" data-filter-list aria-label="Rechercher un média" placeholder="Rechercher parmi les médias"><div class="media-library">{% for asset in media %}<article class="admin-card" data-list-item>{% if asset.image %}<img class="media-library-image" src="{{ cms.mediaUrl(asset.id,'thumb') }}" alt="{{ asset.alt }}" loading="lazy">{% else %}<div class="pdf-icon">PDF</div>{% endif %}<p class="mt-3 text-break"><strong>{{ asset.name }}</strong></p><form action="{{ path('cms_media_edit',{id:asset.id}) }}" method="post"><input type="hidden" name="_token" value="{{ csrf_token('media_' ~ asset.id) }}"><label for="alt-{{ asset.id }}" class="form-label">Description</label><input class="form-control mb-2" id="alt-{{ asset.id }}" name="alt" value="{{ asset.alt }}" maxlength="300"><label class="form-check-label d-block my-2"><input type="checkbox" name="archived" value="1" {% if asset.archived %}checked{% endif %}> Masquer du sélecteur</label><button class="btn btn-sm btn-outline-primary">Enregistrer</button></form></article>{% endfor %}</div>{% endblock %}
