{% extends 'admin/base.html.twig' %}{% block title %}{{ entry.id ? 'Modifier' : 'Créer' }} · {{ types[type] }}{% endblock %}{% block body %}
<a href="{{ path('cms_list',{type:type}) }}">{{ types[type] }}</a><h1 class="mt-3 mb-4">{{ entry.id ? 'Modifier le contenu' : 'Créer un contenu' }}</h1>
{% if errors %}<div class="alert alert-danger" role="alert"><ul class="mb-0">{% for error in errors %}<li>{{ error }}</li>{% endfor %}</ul></div>{% endif %}
<form method="post" class="cms-editor-form"><input type="hidden" name="_token" value="{{ csrf_token('cms_' ~ (entry.id ?: 'new_' ~ type)) }}"><input type="hidden" name="version" value="{{ values.version }}"><div class="row g-4"><div class="col-xl-8"><div class="admin-card"><div class="mb-4"><label class="form-label" for="title">Titre</label><input class="form-control form-control-lg" id="title" name="title" value="{{ values.title }}" maxlength="200" required></div>
{% for key,field in fields %}{% set value=attribute(values.data,key)|default('') %}<div class="mb-4 field-group"><label class="form-label" for="field-{{ key }}">{{ field[0] }}{% if field[2] %} <span aria-hidden="true">*</span>{% endif %}</label>
{% if field[1]=='checkbox' %}<div class="form-check form-switch"><input id="field-{{ key }}" class="form-check-input" type="checkbox" name="data[{{ key }}]" value="1" {% if value %}checked{% endif %}></div>
{% elseif field[1]=='range' %}<input type="range" class="form-range" id="field-{{ key }}" name="data[{{ key }}]" min="0" max="100" value="{{ attribute(values.data,key) is defined ? attribute(values.data,key) : 50 }}" data-focus="{{ key }}"><output for="field-{{ key }}">{{ attribute(values.data,key) is defined ? attribute(values.data,key) : 50 }} %</output>
{% elseif field[1] in ['image','document','gallery'] %}{% set usage=type=='slide' ? (key=='mobile' ? 'slide_mobile' : 'slide') : (key=='icon' ? 'icon' : (key=='logo' or type=='partner' ? 'logo' : 'photo')) %}<div data-media-field data-kind="{{ field[1] }}" data-usage="{{ usage }}" data-key="{{ key }}"><div class="media-selection">{% if field[1]=='gallery' %}{% for mediaId in value ?: [] %}<div class="media-chosen"><input type="hidden" name="data[{{ key }}][]" value="{{ mediaId }}"><img src="{{ cms.mediaUrl(mediaId) }}" alt="{{ cms.alt(mediaId) }}"><button type="button" class="btn btn-sm btn-light" data-remove-media>Retirer</button></div>{% endfor %}{% else %}<input id="field-{{ key }}" type="hidden" name="data[{{ key }}]" value="{{ value }}">{% if value %}<div class="media-chosen">{% if field[1]=='image' %}<img src="{{ cms.mediaUrl(value,'thumb') }}" data-original="{{ cms.mediaUrl(value,'photo') }}" data-width="{{ cms.imageInfo(value).width|default(0) }}" data-height="{{ cms.imageInfo(value).height|default(0) }}" alt="{{ cms.alt(value) }}">{% else %}<span>{{ cms.media(value).name }}</span>{% endif %}</div>{% endif %}{% endif %}</div><button type="button" class="btn btn-outline-primary mt-2" data-pick-media data-name="data[{{ key }}]">Choisir dans la médiathèque</button>{% if field[1]=='image' %}<p class="form-text" data-image-advice>{% if usage=='slide' %}Conseillé : 1920 × 700 px minimum.{% elseif usage=='slide_mobile' %}Conseillé : 780 × 940 px minimum. Sans image mobile, l’image principale est utilisée.{% elseif usage=='logo' %}Logo : proportions et transparence conservées ; version limitée à 480 × 320 px.{% elseif usage=='icon' %}Icône : cadre transparent de 256 × 256 px, sans déformation.{% else %}Photo : versions optimisées pour ordinateur et mobile.{% endif %} Original conservé. Aucun agrandissement du fichier.</p><p class="alert alert-warning" data-image-warning role="status" {% if not cms.imageWarning(value,usage) %}hidden{% endif %}>{{ cms.imageWarning(value,usage) }}</p>{% endif %}{% if not field[2] and field[1]!='gallery' %}<button type="button" class="btn btn-link" data-clear-media>Retirer</button>{% endif %}</div>
{% elseif field[1]=='rich' %}<div class="rich-toolbar" role="toolbar" aria-label="Mise en forme"><button type="button" data-format="bold" aria-label="Gras"><strong>G</strong></button><button type="button" data-format="italic" aria-label="Italique"><em>I</em></button><button type="button" data-format="insertUnorderedList">Liste</button><button type="button" data-format="h3">Sous-titre</button><button type="button" data-format="createLink">Lien</button><button type="button" data-format="removeFormat">Effacer le style</button></div><div id="field-{{ key }}" contenteditable="true" role="textbox" aria-multiline="true" aria-label="{{ field[0] }}" class="rich-editor">{{ value|raw }}</div><textarea name="data[{{ key }}]" class="rich-source" hidden>{{ value }}</textarea><p class="form-text">Paragraphes, titres, listes et liens. Les styles du site sont appliqués automatiquement.</p>
{% elseif field[1]=='textarea' %}<textarea class="form-control" rows="4" id="field-{{ key }}" name="data[{{ key }}]" maxlength="5000" {% if field[2] %}required{% endif %}>{{ value }}</textarea>
{% else %}<input class="form-control" type="{{ field[1]=='email' ? 'email' : 'text' }}" id="field-{{ key }}" name="data[{{ key }}]" value="{{ value }}" maxlength="500" {% if field[2] %}required{% endif %}>{% if field[1]=='url' %}<div class="form-text">Lien interne (/contact) ou adresse complète (https://…).</div>{% endif %}
{% endif %}</div>{% endfor %}{% if type=='slide' %}<section class="crop-previews"><h2 class="h5">Aperçu du cadrage</h2><p class="form-text">Déplacez les curseurs pour conserver le sujet visible. Le recadrage exact dépend de la taille de l’écran.</p><p>Ordinateur</p><div class="crop-frame crop-desktop"><img data-crop="desktop" alt="Aperçu du cadrage sur ordinateur"></div><p class="mt-3">Mobile</p><div class="crop-frame crop-mobile"><img data-crop="mobile" alt="Aperçu du cadrage sur mobile"></div></section>{% endif %}</div></div><div class="col-xl-4"><div class="admin-card publish-panel"><h2 class="h5 mb-4">Publication</h2><label class="form-label" for="status">État</label><select class="form-select mb-4" id="status" name="status">{% for key,label in {draft:'Brouillon',published:'Publié',archived:'Archivé'} %}{% if not fixed or key=='published' %}<option value="{{ key }}" {% if values.status==key %}selected{% endif %}>{{ label }}</option>{% endif %}{% endfor %}</select><label class="form-label" for="position">Ordre d’affichage</label><input class="form-control mb-4" type="number" min="0" max="9999" id="position" name="position" value="{{ values.position }}" required><label class="form-label" for="slug">Adresse du contenu</label><input class="form-control" id="slug" name="slug" value="{{ values.slug }}" maxlength="160" {% if entry.id %}readonly{% endif %}><p class="form-text">{% if entry.id %}Adresse conservée pour préserver les liens existants.{% else %}Laissez vide pour la créer à partir du titre.{% endif %}</p><button class="btn btn-primary w-100 mt-3" type="submit">Enregistrer</button>{% if entry.id %}<a class="btn btn-outline-secondary w-100 mt-3" href="{{ path('cms_preview',{id:entry.id}) }}" target="_blank" rel="noopener">Voir l’aperçu enregistré</a>{% endif %}<p class="form-text mt-3">Les modifications d’un contenu publié sont visibles dès l’enregistrement.</p><a href="{{ path('cms_media') }}" target="_blank" rel="noopener">Importer une image ou un PDF</a><p class="form-text">Vous pouvez aussi importer directement depuis le sélecteur, sans quitter ce formulaire.</p></div></div></div></form>
<dialog id="media-picker" data-catalogue-url="{{ path('cms_media_catalogue') }}"><div class="d-flex justify-content-between align-items-center mb-3"><h2 class="h4 mb-0">Choisir un média</h2><button class="btn btn-light" type="button" data-close-picker>Fermer</button></div><form data-inline-upload action="{{ path('cms_media') }}" method="post" enctype="multipart/form-data" class="border rounded p-3 mb-3">
<input type="hidden" name="_token" value="{{ csrf_token('media') }}"><h3 class="h6">Importer un nouveau média</h3><div class="row g-2"><div class="col-sm-5"><label for="inline-file" class="form-label">Fichier</label><input class="form-control" id="inline-file" name="file" type="file" accept="image/jpeg,image/png,image/webp,application/pdf" required></div><div class="col-sm-5"><label for="inline-alt" class="form-label">Description de l’image</label><input class="form-control" id="inline-alt" name="alt" maxlength="300"></div><div class="col-sm-2 d-flex align-items-end"><button class="btn btn-primary" type="submit">Importer</button></div></div><p class="form-text mb-0" data-upload-limit>JPG, PNG, WebP ou PDF.</p>
</form><p class="alert d-none" data-picker-status role="status" aria-live="polite"></p><input class="form-control mb-3" type="search" data-media-search aria-label="Rechercher un média" placeholder="Rechercher une image, une icône…"><div class="media-picker-grid">{% for asset in media %}{% if not asset.archived %}<button type="button" class="media-option" data-media-id="{{ asset.id }}" data-media-kind="{{ asset.image ? 'image' : 'document' }}" data-media-url="{{ cms.mediaUrl(asset.id) }}" data-media-name="{{ asset.name }}">{% if asset.image %}<img src="{{ cms.mediaUrl(asset.id,'thumb') }}" alt="{{ asset.alt }}" loading="lazy">{% else %}<span class="pdf-icon">PDF</span>{% endif %}<span>{{ asset.name }}</span></button>{% endif %}{% endfor %}</div></dialog>
{% endblock %}
