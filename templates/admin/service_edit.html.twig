{% extends 'admin/base.html.twig' %}
{% block title %}Modifier un service · GMC{% endblock %}
{% block body %}
<section class="panel"><h1 class="h3">Modifier le service</h1><p class="text-secondary">{{ service.title }}</p>
{% if error %}<div class="alert alert-danger" role="alert">{{ error }}</div>{% endif %}
<form method="post" action="{{ path('admin_service_edit', {id: service.id}) }}">
<input type="hidden" name="_token" value="{{ csrf_token('service_' ~ service.id) }}"><input type="hidden" name="version" value="{{ values.version }}">
<h2 class="h5 mt-4 mb-3">Sur l’accueil</h2>
<div class="mb-3"><label for="title" class="form-label">Titre court</label><input class="form-control" id="title" name="title" value="{{ values.title }}" maxlength="120" required><div class="form-text">120 caractères maximum.</div></div>
<div class="mb-3"><label for="summary" class="form-label">Résumé</label><textarea class="form-control" id="summary" name="summary" maxlength="500" required>{{ values.summary }}</textarea><div class="form-text">500 caractères maximum.</div></div>
<div class="mb-4"><label for="tagline" class="form-label">Mention sous le résumé</label><input class="form-control" id="tagline" name="tagline" value="{{ values.tagline }}" maxlength="120" required><div class="form-text">120 caractères maximum.</div></div>
<h2 class="h5 mt-4 mb-3">Sur la page Services</h2>
<div class="mb-3"><label for="listTitle" class="form-label">Titre détaillé</label><input class="form-control" id="listTitle" name="listTitle" value="{{ values.listTitle }}" maxlength="200" required><div class="form-text">200 caractères maximum.</div></div>
<div class="mb-4"><label for="description" class="form-label">Description</label><textarea class="form-control" id="description" name="description" maxlength="3000" required>{{ values.description }}</textarea><div class="form-text">3 000 caractères maximum. Le texte est affiché sans mise en forme HTML.</div></div>
<div class="d-flex gap-3 align-items-center"><button class="btn btn-primary">Enregistrer</button><a href="{{ path('admin_services') }}">Annuler</a></div>
</form></section>
{% endblock %}
