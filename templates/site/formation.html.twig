              </ul>

              <h3 class="text-color-dark font-weight-bold text-transform-none text-5-5 line-height-1 mb-3-5">Nous contacter</h3>
              <p class="text-2 line-height-9">Envoyez-nous un message pour recevoir les programmes détaillés et planifier vos sessions.</p>
              
              <form class="form-style-3" data-gmc-contact action="{{ path('app_contact_send') }}" method="POST" id="contactForm">
<input type="hidden" name="_token" value="{{ csrf_token('contact') }}">
                <div class="alert alert-success d-none mt-4" id="contactSuccess" role="status">
                  <strong>Merci !</strong> Votre message a été envoyé avec succès.
                </div>
                <div class="alert alert-danger d-none mt-4" id="contactError" role="alert">
                  <strong>Erreur !</strong> <span id="errorMessage">Une erreur est survenue.</span>
                </div>
              
                <div class="row">
                  <div class="form-group col mb-3-5">
                    <input type="text" class="form-control text-2 h-auto py-2-5" name="name" maxlength="120" placeholder="Votre nom" required>
                  </div>
                </div>
                <div class="row">
                  <div class="form-group col mb-3-5">
                    <input type="email" class="form-control text-2 h-auto py-2-5" name="email" maxlength="254" placeholder="Votre e-mail" required>
                  </div>
                </div>
                <div class="row">
                  <div class="form-group col mb-3-5">
                    <select name="subject" class="form-control text-2 h-auto py-2-5" required>
                      <option value="">Choisir une formation…</option>
                      {% for training in trainings %}<option value="{{ training.shortTitle }}">{{ training.shortTitle }}</option>{% endfor %}
                    </select>
                  </div>
                </div>
                <div class="row">
                  <div class="form-group col mb-3-5">
                    <textarea rows="4" class="form-control text-2 h-auto py-2-5" name="message" maxlength="10000" placeholder="Message"
                      required></textarea>
                  </div>
                </div>
                <div class="row">
                  <div class="form-group col">
                    <button type="submit"
                      class="custom-view-more d-inline-flex align-items-center btn btn-primary font-weight-semibold rounded-0 text-2 btn-px-4 btn-py-1">
                      Envoyer
                      <img width="27" height="27" src="{{ asset('img/demos/construction/icons/arrow-right.svg') }}" alt="" data-icon
                        data-plugin-options='{"onlySVG": true, "extraClass": "svg-fill-color-light ms-2"}' />
                    </button>
                  </div>
                </div>
              </form>
              
              
              
               
            </aside>
          </div>
        </div>
      </div>

      <div class="position-relative pb-5 d-sm-none d-xl-block">
        <div class="position-absolute transform3dy-n50 left-0">
          <div class="appear-animation" data-appear-animation="fadeInRightShorterPlus" data-appear-animation-delay="1500" data-appear-animation-duration="1500ms">
            <div class="custom-square-1 bg-primary mt-0 mb-5"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- FOOTER -->
    {% include 'site/partials/_footer.html.twig' %}
  </div>

