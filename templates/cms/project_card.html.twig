{% set category=cms.projectCategory(item) %}<article class="project-card" data-project-card data-category="{{ category ? category.id : 'none' }}"><a class="project-card-link" href="{{ path('cms_project_detail',{slug:item.slug}) }}">{% include 'cms/project_picture.html.twig' %}<div class="project-card-copy">{% if category %}<p class="project-kicker">{{ category.title }}</p>{% endif %}<h3>{{ item.title }}</h3><p class="project-meta">{{ item.data.location|default('') }}{% if item.data.location|default('') and item.data.year|default('') %}<span aria-hidden="true"> · </span>{% endif %}{{ item.data.year|default('') }}</p>{% if item.data.summary|default('') %}<p>{{ item.data.summary }}</p>{% endif %}<span class="project-card-cta">Voir le projet</span></div></a></article>