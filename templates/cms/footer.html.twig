<footer class="gmc-footer" aria-label="Pied de page">
<div class="container">
{% if settings.data.footerCtaVisible ?? true %}<div class="gmc-footer-invite"><div><p class="gmc-footer-eyebrow">{{ settings.data.footerCtaEyebrow|default('Échangeons sur vos besoins') }}</p><h2>{{ settings.data.footerCtaTitle|default('Votre prochain projet commence ici.') }}</h2>{% if settings.data.footerCtaText|default('') %}<p>{{ settings.data.footerCtaText }}</p>{% endif %}</div><a class="gmc-footer-button" href="{{ settings.data.footerCtaLink|default(path('app_contact')) }}">{{ settings.data.footerCtaButton|default('Parlons de votre projet') }}</a></div>{% endif %}
<div class="gmc-footer-grid"><section class="gmc-footer-brand"><a class="gmc-footer-logo" href="{{ path('app_home') }}" aria-label="{{ settings.title }} — Accueil"><img src="{{ cms.mediaUrl(settings.data.logo,'logo') }}" alt="{{ settings.title }}" width="120" height="90" loading="lazy"></a><h2>{{ settings.title }}</h2>{% if settings.data.footerDescription|default('') %}<p>{{ settings.data.footerDescription|nl2br }}</p>{% endif %}<div class="gmc-footer-socials">{% for key,label in {facebook:'Facebook',instagram:'Instagram',linkedin:'LinkedIn',x:'X'} %}{% if attribute(settings.data,key)|default('') %}<a href="{{ attribute(settings.data,key) }}" rel="noopener noreferrer" aria-label="{{ settings.title }} sur {{ label }}">{{ label }}</a>{% endif %}{% endfor %}</div></section>
<nav aria-label="Navigation de pied de page"><h2>{{ settings.data.footerNavTitle|default('Découvrir GMC') }}</h2><ul>{% for item in cms.menuEntries('footer') %}{% if item.data.footer %}<li><a href="{{ item.data.link }}">{{ item.title }}</a></li>{% endif %}{% endfor %}</ul></nav>
{% set services=cms.entries('service') %}{% if services %}<nav aria-label="Services de pied de page"><h2>{{ settings.data.footerServicesTitle|default('Nos expertises') }}</h2><ul>{% for service in services %}<li><a href="{{ path('cms_service_detail',{slug:service.slug}) }}">{{ service.title }}</a></li>{% endfor %}</ul></nav>{% endif %}
<section class="gmc-footer-contact"><h2>{{ settings.data.footerContactTitle|default('Nous contacter') }}</h2>{% if contact.data.address|default('') %}<address>{{ contact.data.address|nl2br }}</address>{% endif %}<ul>{% for key in ['phone','phone2'] %}{% set phone=attribute(contact.data,key)|default('') %}{% if phone %}<li><a href="tel:{{ phone|replace({' ':'','(':'',')':'','.':'','-':''}) }}">{{ phone }}</a></li>{% endif %}{% endfor %}{% if contact.data.email|default('') %}<li><a href="mailto:{{ contact.data.email }}">{{ contact.data.email }}</a></li>{% endif %}{% if contact.data.whatsapp|default('') %}<li><a class="gmc-footer-whatsapp" href="https://wa.me/{{ contact.data.whatsapp|replace({'+':'',' ':'','(':'',')':'','.':'','-':''}) }}" rel="noopener noreferrer">Échanger sur WhatsApp</a></li>{% endif %}</ul>{% if contact.data.hours|default('') %}<p class="gmc-footer-hours">{{ contact.data.hours|nl2br }}</p>{% endif %}</section></div>
<div class="gmc-footer-bottom"><p>© {{ 'now'|date('Y') }} {{ settings.data.footer|default(settings.title) }}</p><nav aria-label="Informations légales">{% if settings.data.legalUrl|default('') %}<a href="{{ settings.data.legalUrl }}">Mentions légales</a>{% endif %}{% if settings.data.privacyUrl|default('') %}<a href="{{ settings.data.privacyUrl }}">Confidentialité</a>{% endif %}<a href="#main-content">Retour au contenu</a></nav></div>
</div></footer>