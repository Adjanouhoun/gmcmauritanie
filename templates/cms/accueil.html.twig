{% extends 'cms/base.html.twig' %}
{% block body %}{% set home=cms.one('home') %}{% set slides=cms.entries('slide') %}
{% if home.data.slidesVisible and slides|length %}
<div class="owl-carousel owl-theme m-0" data-plugin-options='{"items":1,"loop":{{ slides|length>1 ? 'true':'false' }},"autoplay":false,"nav":true,"dots":true,"autoHeight":false}'>
{% for slide in slides %}<section class="cms-slide" style="--focus-x:{{ slide.data.focusX ?? 50 }}%;--focus-y:{{ slide.data.focusY ?? 50 }}%;--mobile-focus-x:{{ slide.data.mobileFocusX ?? 50 }}%;--mobile-focus-y:{{ slide.data.mobileFocusY ?? 50 }}%"><picture><source media="(max-width:767px)" srcset="{{ cms.mediaUrl(slide.data.mobile ?: slide.data.image,'slide_mobile') }}"><img src="{{ cms.mediaUrl(slide.data.image,'slide') }}" alt="{{ cms.alt(slide.data.image) }}" {% if loop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}></picture><div class="cms-slide-shade"></div><div class="container cms-slide-copy"><h2 class="text-white font-weight-bold">{{ slide.title }}</h2>{% if slide.data.text %}<p class="text-white">{{ slide.data.text|nl2br }}</p>{% endif %}{% if slide.data.button and slide.data.link %}<a class="btn btn-primary btn-lg" href="{{ slide.data.link }}">{{ slide.data.button }}</a>{% endif %}</div></section>{% endfor %}</div>
{% endif %}
<section class="container py-5 my-3"><div class="row gy-4 align-items-center"><div class="col-lg-6"><h1 class="font-weight-bold text-7">{{ home.title }}</h1><div class="cms-rich">{{ home.data.intro|raw }}</div></div><div class="col-lg-6"><div class="cms-rich">{{ home.data.secondary|raw }}</div>{% if home.data.highlight %}<p class="text-primary font-weight-bold">{{ home.data.highlight }}</p>{% endif %}{% if home.data.button and home.data.link %}<a href="{{ home.data.link }}" class="text-primary font-weight-semibold">{{ home.data.button }}</a>{% endif %}</div></div></section>
{% if home.data.servicesVisible %}<section class="section border-0 m-0"><div class="container py-4"><h2 class="font-weight-bold">{{ home.data.servicesTitle }}</h2><p class="mb-5">{{ home.data.servicesIntro }}</p>{% include 'cms/cards.html.twig' with {items:cms.entries('service'),featuredOnly:true} %}<div class="text-center mt-5"><a class="btn btn-primary" href="{{ path('app_services') }}">Voir tous nos services</a></div></div></section>{% endif %}
{% if home.data.trainingVisible %}<section class="container py-5 my-3"><h2 class="font-weight-bold">{{ home.data.trainingTitle }}</h2><p class="mb-5">{{ home.data.trainingIntro }}</p>{% include 'cms/cards.html.twig' with {items:cms.entries('training'),featuredOnly:true} %}<div class="text-center mt-5"><a class="btn btn-primary" href="{{ path('app_formation') }}">Voir toutes nos formations</a></div></section>{% endif %}
{% if home.data.partnersVisible %}<section class="section border-0 m-0"><div class="container"><h2 class="text-center font-weight-bold mb-5">{{ home.data.partnersTitle }}</h2>{% include 'cms/partners.html.twig' %}</div></section>{% endif %}
{% endblock %}
