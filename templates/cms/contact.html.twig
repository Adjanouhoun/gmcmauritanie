{% extends 'cms/base.html.twig' %}{% block body %}<section class="container py-5 my-3"><div class="row gy-5"><div class="col-lg-5"><h2 class="font-weight-bold">{{ contact.title }}</h2><address>{{ contact.data.address|nl2br }}</address>{% for phone in [contact.data.phone,contact.data.phone2] %}{% if phone %}<p><a href="tel:{{ phone|replace({' ': '', '(': '', ')': '', '.': '', '-': ''}) }}">{{ phone }}</a></p>{% endif %}{% endfor %}<p><a href="mailto:{{ contact.data.email }}">{{ contact.data.email }}</a></p>{% if contact.data.whatsapp %}<p><a href="https://wa.me/{{ contact.data.whatsapp|replace({'+':'',' ':'','(':'',')':'','-':'','.':''}) }}">Nous contacter sur WhatsApp</a></p>{% endif %}{% if contact.data.hours %}<h3 class="h5 mt-4">Horaires</h3><p>{{ contact.data.hours|nl2br }}</p>{% endif %}{% if contact.data.mapQuery %}<iframe class="cms-map" title="Localisation de {{ settings.title }}" src="https://www.google.com/maps?q={{ contact.data.mapQuery|url_encode }}&amp;output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>{% endif %}</div><div class="col-lg-7"><h2 class="font-weight-bold">{{ contact.data.formTitle }}</h2><p>{{ contact.data.formIntro }}</p><form data-gmc-contact action="{{ path('app_contact_send') }}" method="post" id="contactForm"><input type="hidden" name="_token" value="{{ csrf_token('contact') }}"><div class="alert alert-success d-none" id="contactSuccess" role="status">Votre message a été envoyé.</div><div class="alert alert-danger d-none" id="contactError" role="alert"><span id="errorMessage"></span></div>
<div class="mb-3"><label class="form-label" for="name">Votre nom</label><input class="form-control" id="name" name="name" maxlength="120" required></div><div class="mb-3"><label class="form-label" for="email">Votre e-mail</label><input class="form-control" type="email" id="email" name="email" maxlength="254" required></div><div class="mb-3"><label class="form-label" for="subject">Sujet</label><input class="form-control" id="subject" name="subject" maxlength="200" required></div><div class="mb-4"><label class="form-label" for="message">Votre message</label><textarea class="form-control" rows="6" id="message" name="message" maxlength="10000" required></textarea></div><button type="submit" class="btn btn-primary btn-lg">Envoyer</button></form></div></div></section>{% endblock %}
