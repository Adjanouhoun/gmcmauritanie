{% extends 'cms/base.html.twig' %}{% block body %}{% set about=cms.one('about') %}<section class="container py-5 my-3"><div class="row gy-4 align-items-center"><div class="col-lg-6"><h2 class="font-weight-bold">{{ about.title }}</h2><div class="cms-rich">{{ about.data.body|raw }}</div></div><div class="col-lg-6"><picture><source media="(max-width:767px)" srcset="{{ cms.mediaUrl(about.data.image,'photo_small') }}"><img src="{{ cms.mediaUrl(about.data.image) }}" alt="{{ cms.alt(about.data.image) }}" class="img-fluid rounded"></picture></div></div>{% include 'cms/gallery.html.twig' with {images:about.data.gallery} %}</section>
{% for block in cms.entries('about_block') %}<section class="section border-0 m-0 {{ loop.index is odd ? 'bg-light' : 'bg-white' }}"><div class="container"><div class="row gy-4"><div class="{{ block.data.image ? 'col-lg-8':'col-12' }}"><h2 class="font-weight-bold">{{ block.title }}</h2><div class="cms-rich">{{ block.data.body|raw }}</div></div>{% if block.data.image %}<div class="col-lg-4"><picture><source media="(max-width:767px)" srcset="{{ cms.mediaUrl(block.data.image,'photo_small') }}"><img class="img-fluid rounded" src="{{ cms.mediaUrl(block.data.image) }}" alt="{{ cms.alt(block.data.image) }}"></picture></div>{% endif %}</div></div></section>{% endfor %}<section class="container py-5">{% include 'cms/partners.html.twig' %}</section>{% endblock %}
