{% extends 'cms/base.html.twig' %}{% block body %}<section class="container py-5 my-3"><div class="row gy-5"><div class="col-lg-8">
{% for item in cms.entries('training') %}<article id="formation-{{ item.slug }}" class="mb-5 pb-4 border-bottom"><div class="d-flex align-items-center gap-3 mb-4"><img class="cms-icon" src="{{ cms.mediaUrl(item.data.icon,'icon') }}" alt="{{ cms.alt(item.data.icon) }}"><h2 class="text-6 font-weight-bold mb-0">{{ item.title }}</h2></div><div class="cms-rich">{{ item.data.body|raw }}</div>{% include 'cms/training_info.html.twig' %}<a class="btn btn-primary" href="{{ path('cms_training_detail',{slug:item.slug}) }}">Voir le programme</a></article>{% endfor %}</div><aside class="col-lg-4"><h2 class="h4">Nos formations</h2><ul class="list list-unstyled">{% for item in cms.entries('training') %}<li class="py-2 border-bottom"><a href="#formation-{{ item.slug }}">{{ item.data.shortTitle }}</a></li>{% endfor %}</ul></aside></div></section>{% endblock %}
