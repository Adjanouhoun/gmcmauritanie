{% set settings = cms.one('settings') %}{% set contact = cms.one('contact') %}
<!DOCTYPE html><html lang="fr"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ meta.data.seoTitle|default(meta.title|default(settings.title)) }} · {{ settings.title }}</title>
<meta name="description" content="{{ meta.data.seoDescription|default(meta.data.intro|default('')) }}">
{% if cms.preview %}<meta name="robots" content="noindex,nofollow">{% endif %}
{% if settings.data.favicon %}<link rel="icon" href="{{ cms.mediaUrl(settings.data.favicon) }}">{% endif %}
<link href="https://fonts.googleapis.com/css?family=Poppins:300,400,500,600,700,800&display=swap" rel="stylesheet">
{% for css in ['vendor/bootstrap/css/bootstrap.min.css','vendor/fontawesome-free/css/all.min.css','vendor/animate/animate.compat.css','vendor/simple-line-icons/css/simple-line-icons.min.css','vendor/owl.carousel/assets/owl.carousel.min.css','vendor/owl.carousel/assets/owl.theme.default.min.css','vendor/magnific-popup/magnific-popup.min.css','css/theme.css','css/theme-elements.css','css/demos/demo-construction.css','css/skins/skin-construction.css','css/custom.css','css/gmc-cms.css'] %}<link rel="stylesheet" href="{{ asset(css) }}">{% endfor %}
</head><body><div class="body">
{% if cms.preview %}<div class="cms-preview-bar">Aperçu privé — les modifications enregistrées en brouillon ne sont pas publiques. <a href="{{ path('cms_edit',{type:cms.preview.type,id:cms.preview.id}) }}">Retour à l’édition</a></div>{% endif %}
<a class="gmc-skip" href="#main-content">Aller au contenu</a>
<header class="gmc-header" data-site-header><div class="container gmc-header-row"><a href="{{ path('app_home') }}" class="gmc-brand" aria-label="{{ settings.title }} — Accueil"><img src="{{ cms.mediaUrl(settings.data.logo,'logo') }}" alt="{{ settings.title }}" width="100" height="76"></a>
<button class="gmc-menu-toggle" type="button" aria-expanded="false" aria-controls="gmc-navigation" hidden><span data-menu-label>Menu</span><span aria-hidden="true" data-menu-symbol>☰</span></button>
<nav id="gmc-navigation" class="gmc-navigation" aria-label="Navigation principale"><ul>{% for item in cms.menuEntries('header') %}{% set link=item.data.link %}{% set active=app.request.pathInfo==link or (link=='/services' and page=='services') or (link=='/formation' and page=='formation') or (link=='/realisations' and page=='realisations') or (link=='/' and page=='accueil') %}{% set services=link=='/services' ? cms.entries('service') : [] %}
<li class="gmc-nav-item{% if services %} gmc-has-submenu{% endif %}"><div class="gmc-nav-entry"><a class="gmc-nav-link{% if active %} is-active{% endif %}{% if link=='/contact' %} gmc-contact-link{% endif %}" href="{{ link }}" {% if active %}aria-current="{{ app.request.pathInfo==link ? 'page':'location' }}"{% endif %}>{{ item.data.headerLabel|default(item.title) }}</a>{% if services %}<button class="gmc-submenu-toggle" type="button" aria-expanded="false" aria-controls="gmc-services-{{ item.id }}" aria-label="Afficher les services" hidden><span aria-hidden="true">⌄</span></button>{% endif %}</div>
{% if services %}<ul class="gmc-submenu" id="gmc-services-{{ item.id }}">{% for service in services %}<li><a href="{{ path('cms_service_detail',{slug:service.slug}) }}" {% if meta.id|default(null)==service.id %}aria-current="page"{% endif %}>{{ service.title }}</a></li>{% endfor %}<li><a class="gmc-all-services" href="{{ path('app_services') }}">Tous nos services</a></li></ul>{% endif %}</li>{% endfor %}</ul></nav></div></header>
<main class="main" id="main-content" tabindex="-1">
{% block page_banner %}{% if page != 'accueil' %}<section class="section border-0 m-0 cms-banner" {% if meta.data.image|default(null) %}style="background-image:linear-gradient(90deg,rgba(25,30,34,.85),rgba(25,30,34,.45)),url('{{ cms.mediaUrl(meta.data.image) }}')"{% endif %}><div class="container py-4"><a href="{{ path('app_home') }}" class="text-color-light">Accueil</a><h1 class="text-color-light font-weight-bold mt-3 mb-0">{{ meta.title }}</h1>{% if meta.data.intro|default('') %}<p class="text-color-light mt-3 mb-0">{{ meta.data.intro }}</p>{% endif %}</div></section>{% endif %}
{% endblock %}
{% block body %}{% endblock %}
</main>
{% include 'cms/footer.html.twig' %}
</div>
{% for js in ['vendor/plugins/js/plugins.min.js','js/theme.js','js/theme.init.js','js/contact.js','js/navigation.js'] %}<script src="{{ asset(js) }}"></script>{% endfor %}
</body></html>
