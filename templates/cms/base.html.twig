{% set settings = cms.one('settings') %}{% set contact = cms.one('contact') %}
<!DOCTYPE html><html lang="fr"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ meta.data.seoTitle|default(meta.title|default(settings.title)) }} · {{ settings.title }}</title>
<meta name="description" content="{{ meta.data.seoDescription|default(meta.data.intro|default('')) }}">
{% if cms.preview %}<meta name="robots" content="noindex,nofollow">{% endif %}
{% if settings.data.favicon %}<link rel="icon" href="{{ cms.mediaUrl(settings.data.favicon) }}">{% endif %}
<link href="https://fonts.googleapis.com/css?family=Poppins:300,400,500,600,700,800&display=swap" rel="stylesheet">
{% for css in ['vendor/bootstrap/css/bootstrap.min.css','vendor/fontawesome-free/css/all.min.css','vendor/animate/animate.compat.css','vendor/simple-line-icons/css/simple-line-icons.min.css','vendor/owl.carousel/assets/owl.carousel.min.css','vendor/owl.carousel/assets/owl.theme.default.min.css','vendor/magnific-popup/magnific-popup.min.css','css/theme.css','css/theme-elements.css','css/demos/demo-construction.css','css/skins/skin-construction.css','css/custom.css','css/gmc-cms.css'] %}<link rel="stylesheet" href="{{ asset(css) }}">{% endfor %}
</head><body><div class="body">
{% if cms.preview %}<div class="cms-preview-bar">Aperçu privé — les modifications enregistrées en brouillon ne sont pas publiques. <a href="{{ path('cms_edit',{type:cms.preview.type,id:cms.preview.id}) }}">Retour à l’édition</a></div>{% endif %}
<header id="header" data-plugin-options="{'stickyEnabled':true,'stickyStartAt':80,'stickySetTop':'0'}"><div class="header-body border-0"><div class="header-container container"><div class="header-row py-2"><div class="header-column"><div class="header-row"><a href="{{ path('app_home') }}" class="header-logo"><img src="{{ cms.mediaUrl(settings.data.logo,'logo') }}" alt="{{ settings.title }}" width="110" height="88" style="object-fit:contain"></a></div></div>
<div class="header-column justify-content-end"><div class="header-row"><div class="header-nav header-nav-links"><div class="header-nav-main header-nav-main-square header-nav-main-text-capitalize"><nav class="collapse"><ul class="nav nav-pills" id="mainNav">{% for item in cms.entries('menu') %}<li><a class="nav-link{% if app.request.pathInfo == item.data.link %} active{% endif %}" href="{{ item.data.link }}">{{ item.title }}</a></li>{% endfor %}</ul></nav></div><button class="btn header-btn-collapse-nav" type="button" aria-label="Ouvrir le menu" data-bs-toggle="collapse" data-bs-target=".header-nav-main nav"><i class="fas fa-bars"></i></button></div></div></div></div></div></div></header>
<main class="main">
{% if page != 'accueil' %}<section class="section border-0 m-0 cms-banner" {% if meta.data.image|default(null) %}style="background-image:linear-gradient(90deg,rgba(25,30,34,.85),rgba(25,30,34,.45)),url('{{ cms.mediaUrl(meta.data.image) }}')"{% endif %}><div class="container py-4"><a href="{{ path('app_home') }}" class="text-color-light">Accueil</a><h1 class="text-color-light font-weight-bold mt-3 mb-0">{{ meta.title }}</h1>{% if meta.data.intro|default('') %}<p class="text-color-light mt-3 mb-0">{{ meta.data.intro }}</p>{% endif %}</div></section>{% endif %}
{% block body %}{% endblock %}
</main>
<footer id="footer" class="border-0 mt-0"><div class="container py-5"><div class="row gy-4"><div class="col-md-4"><img src="{{ cms.mediaUrl(settings.data.logo,'logo') }}" alt="{{ settings.title }}" width="100" height="80" style="object-fit:contain;background:white;border-radius:6px"><p class="mt-3">{{ settings.data.footer|nl2br }}</p></div><div class="col-md-4"><h4 class="text-white">Navigation</h4><ul class="list list-unstyled">{% for item in cms.entries('menu') %}{% if item.data.footer %}<li><a href="{{ item.data.link }}">{{ item.title }}</a></li>{% endif %}{% endfor %}</ul></div><div class="col-md-4"><h4 class="text-white">Contact</h4><p>{{ contact.data.address|nl2br }}</p><p><a href="tel:{{ contact.data.phone|replace({' ': '', '(': '', ')': '', '.': '', '-': ''}) }}">{{ contact.data.phone }}</a><br><a href="mailto:{{ contact.data.email }}">{{ contact.data.email }}</a></p><div class="d-flex gap-3">{% for social in ['facebook','instagram','linkedin','x'] %}{% if attribute(settings.data,social)|default('') %}<a href="{{ attribute(settings.data,social) }}" rel="noopener noreferrer" aria-label="{{ social }}"><i class="fab fa-{{ social == 'x' ? 'x-twitter' : social }}"></i></a>{% endif %}{% endfor %}</div></div></div></div></footer>
</div>
{% for js in ['vendor/plugins/js/plugins.min.js','js/theme.js','js/theme.init.js','js/contact.js'] %}<script src="{{ asset(js) }}"></script>{% endfor %}
</body></html>
