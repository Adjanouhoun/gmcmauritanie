{% if images|default([])|length %}<div class="row g-4 my-4">{% for image in images %}<div class="col-sm-6 col-lg-4"><a href="{{ cms.mediaUrl(image,'original') }}"><picture><source media="(max-width:767px)" srcset="{{ cms.mediaUrl(image,'photo_small') }}"><img class="img-fluid rounded w-100" src="{{ cms.mediaUrl(image) }}" alt="{{ cms.alt(image) }}" loading="lazy"></picture></a></div>{% endfor %}</div>{% endif %}
