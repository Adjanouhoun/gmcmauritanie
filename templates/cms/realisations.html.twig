{% extends 'cms/base.html.twig' %}{% block body %}<section class="container py-5 my-3"><div class="row g-5">{% for item in cms.entries('project') %}<article class="col-md-6 col-lg-4"><a href="{{ path('cms_project_detail',{slug:item.slug}) }}"><picture><source media="(max-width:767px)" srcset="{{ cms.mediaUrl(item.data.image,'photo_small') }}"><img class="cms-project img-fluid rounded mb-3" src="{{ cms.mediaUrl(item.data.image) }}" alt="{{ cms.alt(item.data.image) }}"></picture><h2 class="text-5 font-weight-bold">{{ item.title }}</h2></a><p>{{ item.data.category }}{% if item.data.location %} · {{ item.data.location }}{% endif %}</p></article>{% endfor %}</div></section>{% endblock %}
