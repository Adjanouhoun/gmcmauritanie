{% extends 'cms/base.html.twig' %}
{% block body %}
{% set projects=cms.entries('project') %}{% set featured=null %}{% set categories={} %}
{% for item in projects %}{% if item.data.featured|default(false) and not featured %}{% set featured=item %}{% endif %}{% set category=cms.projectCategory(item) %}{% if category %}{% set categories=categories|merge({('category-' ~ category.id):category}) %}{% endif %}{% endfor %}
{% if not featured and projects %}{% set featured=projects|first %}{% endif %}
<section class="container portfolio-section" data-portfolio>
{% if featured %}{% set category=cms.projectCategory(featured) %}<article class="project-feature" data-project-feature><a class="project-feature-visual" href="{{ path('cms_project_detail',{slug:featured.slug}) }}">{% include 'cms/project_picture.html.twig' with {item:featured,eager:true} %}</a><div class="project-feature-copy"><p class="project-kicker">Projet à la une</p><h2>{{ featured.title }}</h2>{% if category %}<p class="project-feature-category">{{ category.title }}</p>{% endif %}<p class="project-meta">{{ featured.data.location|default('') }}{% if featured.data.location|default('') and featured.data.year|default('') %} · {% endif %}{{ featured.data.year|default('') }}</p>{% if featured.data.summary|default('') %}<p>{{ featured.data.summary }}</p>{% endif %}<a class="btn btn-primary" href="{{ path('cms_project_detail',{slug:featured.slug}) }}">Découvrir le projet</a></div></article>{% endif %}
<div class="portfolio-heading"><div><p class="project-kicker">Le savoir-faire GMC en action</p><h2>Nos projets</h2></div><p data-project-count role="status" aria-live="polite">{{ projects|length }} réalisation{{ projects|length>1?'s':'' }}</p></div>
{% if categories|length>1 %}<div class="project-filters" role="group" aria-label="Filtrer les réalisations par activité" hidden data-project-filters><button type="button" data-project-filter="all" aria-pressed="true">Toutes les activités</button>{% for category in categories %}<button type="button" data-project-filter="{{ category.id }}" aria-pressed="false">{{ category.title }}</button>{% endfor %}</div>{% endif %}
<div class="project-grid">{% for item in projects %}{% include 'cms/project_card.html.twig' %}{% else %}<p class="project-empty">Nos réalisations seront présentées prochainement.</p>{% endfor %}</div>
<div class="project-contact"><div><p class="project-kicker">Construisons la suite ensemble</p><h2>Vous avez un projet similaire ?</h2><p>Échangeons sur vos besoins et les solutions adaptées à votre activité.</p></div><a class="btn btn-primary" href="{{ path('app_contact') }}">Parlons de votre projet</a></div>
</section><script src="{{ asset('js/portfolio.js') }}" defer></script>
{% endblock %}