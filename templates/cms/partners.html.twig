<div class="d-flex flex-wrap justify-content-center align-items-center gap-5">{% for partner in cms.entries('partner') %}<div>{% if partner.data.link %}<a href="{{ partner.data.link }}" rel="noopener noreferrer">{% endif %}<img src="{{ cms.mediaUrl(partner.data.image,'logo') }}" alt="{{ cms.alt(partner.data.image) ?: partner.title }}" class="cms-partner" loading="lazy">{% if partner.data.link %}</a>{% endif %}</div>{% endfor %}</div>
