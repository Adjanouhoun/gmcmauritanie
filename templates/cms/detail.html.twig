{% extends 'cms/base.html.twig' %}{% block body %}<section class="container py-5 my-3"><div class="row gy-4"><article class="col-lg-8">{% if entry.data.image %}<picture><source media="(max-width:767px)" srcset="{{ cms.mediaUrl(entry.data.image,'photo_small') }}"><img class="img-fluid w-100 mb-4 rounded cms-cover" src="{{ cms.mediaUrl(entry.data.image) }}" alt="{{ cms.alt(entry.data.image) }}"></picture>{% endif %}<div class="cms-rich">{{ entry.data.body|raw }}</div>{% if entry.type=='training' %}{% include 'cms/training_info.html.twig' with {item:entry} %}{% endif %}{% include 'cms/gallery.html.twig' with {images:entry.data.gallery} %}</article><aside class="col-lg-4"><div class="bg-light p-4"><h2 class="text-5 font-weight-bold">Parlons de votre projet</h2><p>{{ contact.data.formIntro }}</p><a class="btn btn-primary" href="{{ path('app_contact') }}">Nous contacter</a></div></aside></div></section>{% endblock %}
