{% extends 'cms/base.html.twig' %}
{% block page_banner %}<header class="project-page-heading"><div class="container"><p class="project-kicker">Nos réalisations</p><h1>{{ entry.title }}</h1></div></header>{% endblock %}
{% block body %}{% set category=cms.projectCategory(entry) %}
<section class="container portfolio-section project-detail"><a class="project-back" href="{{ path('app_realisations') }}">Toutes nos réalisations</a>
<div class="project-detail-cover">{% include 'cms/project_picture.html.twig' with {item:entry,eager:true} %}</div>
<div class="project-detail-layout"><article>{% if entry.data.summary|default('') %}<p class="project-lead">{{ entry.data.summary }}</p>{% endif %}{% for key,label in {body:'Le contexte',work:'Notre intervention',results:'Les résultats'} %}{% set text=attribute(entry.data,key)|default('') %}{% if text|striptags|trim %}<section class="project-story"><h2>{{ label }}</h2><div class="cms-rich">{{ text|raw }}</div></section>{% endif %}{% endfor %}</article>
<aside class="project-facts">{% if category or entry.data.location|default('') or entry.data.year|default('') or entry.data.client|default('') %}<h2>Le projet en bref</h2><dl>{% if category %}<dt>Activité</dt><dd>{{ category.title }}</dd>{% endif %}{% for key,label in {location:'Lieu',year:'Année',client:'Client'} %}{% if attribute(entry.data,key)|default('') %}<dt>{{ label }}</dt><dd>{{ attribute(entry.data,key) }}</dd>{% endif %}{% endfor %}</dl>{% endif %}<a class="btn btn-primary" href="{{ path('app_contact') }}">Parlons de votre projet</a></aside></div>
{% if entry.data.gallery|default([])|length %}<section class="project-gallery-section"><p class="project-kicker">Sur le terrain</p><h2>Le projet en images</h2><div class="project-gallery">{% for id in entry.data.gallery %}{% if cms.media(id) %}<a href="{{ cms.mediaUrl(id) }}" data-project-photo data-caption="{{ cms.alt(id) ?: entry.title }}" aria-label="Agrandir la photo {{ loop.index }} : {{ cms.alt(id) ?: entry.title }}"><img src="{{ cms.mediaUrl(id,'photo_small') }}" alt="{{ cms.alt(id) ?: entry.title }}" loading="lazy"></a>{% endif %}{% endfor %}</div></section><dialog class="project-lightbox" aria-label="Galerie du projet"><div class="project-lightbox-toolbar"><p data-photo-count role="status"></p><button type="button" data-photo-close>Fermer</button></div><img data-photo-large alt=""><p data-photo-caption></p><div class="project-lightbox-nav"><button type="button" data-photo-prev aria-label="Photo précédente">Précédente</button><button type="button" data-photo-next aria-label="Photo suivante">Suivante</button></div></dialog>{% endif %}
{% set related=[] %}{% for item in cms.entries('project') %}{% if item.id!=entry.id and category and cms.projectCategory(item) and cms.projectCategory(item).id==category.id and related|length<3 %}{% set related=related|merge([item]) %}{% endif %}{% endfor %}{% if related %}<section class="project-related"><h2>Dans la même activité</h2><div class="project-grid">{% for item in related %}{% include 'cms/project_card.html.twig' %}{% endfor %}</div></section>{% endif %}
</section><script src="{{ asset('js/portfolio.js') }}" defer></script>{% endblock %}