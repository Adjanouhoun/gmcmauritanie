<div class="row gy-5">{% for item in items %}{% if not featuredOnly|default(false) or item.data.featured|default(false) %}
<div class="col-md-6 col-lg-4"><article class="d-flex h-100"><img class="cms-icon" src="{{ cms.mediaUrl(item.data.icon,'icon') }}" alt="{{ cms.alt(item.data.icon) }}"><div class="ps-4"><h3 class="text-color-dark font-weight-bold text-transform-none text-5 mb-2">{{ item.type == 'training' ? item.data.shortTitle : item.title }}</h3><p class="font-weight-light mb-2">{{ item.data.summary }}</p>{% if item.type=='training' %}<p class="text-primary font-weight-semibold">{{ item.data.duration }}</p>{% elseif item.data.tagline %}<p class="text-primary font-weight-semibold">{{ item.data.tagline }}</p>{% endif %}<a class="text-color-primary font-weight-semibold" href="{{ path(item.type == 'training' ? 'cms_training_detail' : 'cms_service_detail',{slug:item.slug}) }}">Découvrir</a></div></article></div>
{% endif %}{% endfor %}</div>
